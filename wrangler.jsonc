{
  "name": "legendmural-cloudflare-preview",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "define": {
    "import.meta.url": "\"file:///legendmural-cloudflare-pdfkit-runtime.mjs\""
  },
  "alias": {
    "pdfkit": "./cloudflare/pdfkit-worker-runtime.mjs"
  },
  "build": {
    "command": "node scripts/generate-cloudflare-commerce-runtime-config.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "LEGENDMURAL_DEPLOY_CONTEXT": "preview",
    "LEGENDMURAL_CHECKOUT_PAUSED": "true",
    "P3_TEST_CHECKOUT_ENABLED": "false",
    "PAYPAL_ALLOW_LIVE": "false",
    "ORDER_EMAILS_ENABLED": "false",
    "V3_PROFILE1_ORDER_CREATION_ENABLED": "false",
    "V3_INVOICE_RECONCILIATION_ENABLED": "false",
    "V3_INVOICE_STORAGE_ENABLED": "false",
    "V3_DASHBOARD_INVOICE_API_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "V3_INVOICE_PDFS",
      "bucket_name": "legendmural-v3-invoice-pdfs-preview",
      "preview_bucket_name": "legendmural-v3-invoice-pdfs-preview"
    }
  ],
  "env": {
    "production": {
      "name": "legendmural-cloudflare-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "legendmural.com",
          "custom_domain": true
        },
        {
          "pattern": "www.legendmural.com",
          "custom_domain": true
        }
      ],
      "define": {
        "import.meta.url": "\"file:///legendmural-cloudflare-pdfkit-runtime.mjs\""
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "vars": {
        "LEGENDMURAL_DEPLOY_CONTEXT": "production",
        "LEGENDMURAL_CHECKOUT_PAUSED": "false",
        "P3_TEST_CHECKOUT_ENABLED": "false",
        "CHECKOUT_SUCCESS_URL": "https://legendmural.com/order-success.html",
        "CHECKOUT_CANCEL_URL": "https://legendmural.com/order-cancelled.html",
        "CHECKOUT_ALLOWED_ORIGINS": "https://legendmural.com",
        "PAYPAL_API_BASE": "https://api-m.paypal.com",
        "PAYPAL_ALLOW_LIVE": "true",
        "ORDER_EMAILS_ENABLED": "true",
        "RESEND_FROM": "LegendMural <orders@mail.legendmural.com>",
        "RESEND_REPLY_TO": "info@legendmural.com",
        "ORDER_NOTIFICATION_TO": "info@legendmural.com",
        "V3_PROFILE1_ORDER_CREATION_ENABLED": "false",
        "V3_INVOICE_RECONCILIATION_ENABLED": "false",
        "V3_INVOICE_STORAGE_ENABLED": "false",
        "V3_DASHBOARD_INVOICE_API_ENABLED": "false"
      },
      "r2_buckets": [
        {
          "binding": "V3_INVOICE_PDFS",
          "bucket_name": "legendmural-v3-invoice-pdfs-prod",
          "preview_bucket_name": "legendmural-v3-invoice-pdfs-preview"
        }
      ]
    }
  }
}
