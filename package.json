{
  "name": "legend-murals",
  "version": "1.0.0",
  "description": "Legend Murals — Premium wall stickers & murals inspired by epic stories, history, and mythology.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/validate-build.mjs",
    "preview": "vite preview",
    "audit": "node scripts/audit.mjs",
