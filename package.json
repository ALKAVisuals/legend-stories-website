{
  "name": "legend-murals",
  "version": "1.0.0",
  "description": "Legend Murals — Premium wall stickers & murals inspired by epic stories, history, and mythology.",
  "private": true,
  "scripts": {
    "predev": "npm run generate:runtime-products",
    "dev": "vite",
    "build": "npm run generate:runtime-products && vite build && node scripts/copy-static-js.mjs && node scripts/validate-build.mjs",
    "preview": "vite preview",
    "audit": "node scripts/audit.mjs",
    "audit:strict": "node scripts/audit.mjs --strict",
    "audit:css": "node scripts/css-audit.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "audit:media": "node scripts/media-audit.mjs",
    "audit:media:strict": "node scripts/media-audit.mjs --strict",
    "audit:runtime": "node scripts/runtime-audit.mjs",
    "audit:product-page-templates": "node scripts/audit-product-page-template-compatibility.mjs",
    "inventory:products": "node scripts/product-inventory.mjs",
    "bootstrap:product-page-batch": "node scripts/bootstrap-product-page-batch.mjs",
    "bootstrap:batch3-pages": "node scripts/bootstrap-product-page-batch.mjs --batch=2026-batch-3 --expected=20",
    "generate:managed-product-pages": "node scripts/generate-managed-product-pages.mjs",
    "generate:managed-product-pages:live": "node scripts/generate-managed-product-pages.mjs --write-live",
    "generate:batch3-pages": "node scripts/generate-managed-product-pages.mjs --batch=2026-batch-3",
    "generate:batch3-pages:live": "node scripts/generate-managed-product-pages.mjs --batch=2026-batch-3 --write-live",
    "generate:full-catalog": "node scripts/generate-full-product-catalog.mjs",
    "generate:product-previews": "node scripts/generate-product-previews.mjs",
    "generate:runtime-products": "node scripts/generate-runtime-product-registry.mjs",
    "validate:managed-product-pages": "node scripts/validate-managed-product-pages.mjs",
    "validate:managed-product-pages:live": "node scripts/validate-managed-product-pages.mjs --live",
    "validate:batch3-pages": "node scripts/validate-managed-product-pages.mjs --batch=2026-batch-3",
    "validate:batch3-pages:live": "node scripts/validate-managed-product-pages.mjs --batch=2026-batch-3 --write-live",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:browser-checkout": "node scripts/validate-browser-checkout.mjs",
    "validate:catalog": "node scripts/validate-product-catalog.mjs",
    "validate:checkout-persistence": "node scripts/validate-checkout-persistence.mjs",
    "validate:commerce-runtime": "node scripts/validate-commerce-runtime.mjs",
    "validate:neon-order-store": "node scripts/validate-neon-order-store.mjs",
    "validate:order-return": "node scripts/validate-order-return.mjs",
    "validate:order-security": "node scripts/validate-order-security.mjs",
    "validate:order-store": "node scripts/validate-order-store-conformance.mjs",
    "validate:stripe-checkout": "node scripts/validate-stripe-checkout.mjs",
    "validate:stripe-webhook": "node scripts/validate-stripe-webhook.mjs",
    "validate:full-catalog": "node scripts/validate-full-product-catalog.mjs",
    "validate:related-products": "node scripts/validate-related-products-runtime.mjs",
    "validate:runtime-products": "node scripts/validate-runtime-product-registry.mjs",
    "test": "node --test tests/*.test.mjs",
    "quality": "npm run audit && npm run audit:css && npm run audit:dependencies && npm run audit:media && npm run audit:runtime && npm run inventory:products && npm run validate:full-catalog && npm run audit:product-page-templates && npm run generate:managed-product-pages && npm run validate:managed-product-pages:live && npm run generate:runtime-products && npm run validate:runtime-products && npm run validate:related-products && npm run validate:commerce-runtime && npm run validate:order-security && npm run validate:stripe-checkout && npm run validate:browser-checkout && npm run validate:order-store && npm run validate:neon-order-store && npm run validate:checkout-persistence && npm run validate:stripe-webhook && npm run validate:order-return && npm run generate:product-previews && npm run validate:catalog && npm test && npm run build"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "terser": "^5.48.0",
    "vite": "6.4.3"
  }
}
