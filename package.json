    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.48.0",
    "vite": "^5.1.4"
  }
}
