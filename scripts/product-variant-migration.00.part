import { createHash } from 'node:crypto';
import { readFile, readdir, writeFile } from 'node:fs/promises';
import { join } from 'node:path';

const ROOT = process.cwd();
const DEFAULT_VARIANT_ID = 'statement-45';
const VARIANTS = [
  {
    id: 'statement-45',
    label: 'Statement',
    sizeCm: 45,
    price: 45,
    skuSuffix: '45',
    isDefault: true,
  },
  {
    id: 'compact-30',
    label: 'Compact',
    sizeCm: 30,
    price: 35,
    skuSuffix: '30',
    isDefault: false,
  },
];

async function read(path) {
  return readFile(join(ROOT, path), 'utf8');
}

async function write(path, content) {
  await writeFile(join(ROOT, path), content, 'utf8');
  console.log(`Updated ${path}`);
}

function replaceOnce(source, pattern, replacement, label) {
  const matches = typeof pattern === 'string'
    ? source.split(pattern).length - 1
    : [...source.matchAll(new RegExp(pattern.source, pattern.flags.includes('g') ? pattern.flags : `${pattern.flags}g`))].length;
  if (matches !== 1) {
    throw new Error(`${label}: expected one match, found ${matches}.`);
  }
  return source.replace(pattern, replacement);
}

function normalizeDescription(value = '') {
  let description = String(value)
    .replace(/\s*60\s*[x×]\s*90\s*cm,?/gi, '')
    .replace(/\s{2,}/g, ' ')
    .replace(/\s+,/g, ',')
    .replace(/,\s*\./g, '.')
    .trim();
  if (!/[.!?]$/.test(description)) description += '.';
  const sizing = ' Available in 30 cm and 45 cm, measured along the longest side.';
  if (!/available in 30 cm and 45 cm/i.test(description)) description += sizing;
  return description;
}

async function migrateCatalog() {
  const path = 'data/products/catalog.json';
  const catalog = JSON.parse(await read(path));
  catalog.schemaVersion = 2;
  catalog.variantPolicy = {
    defaultVariantId: DEFAULT_VARIANT_ID,
    sizeMeasurement: 'longest_side',
    variants: VARIANTS,
  };
  catalog.products = catalog.products.map((product) => ({
    ...product,
    description: normalizeDescription(product.description),
    price: 45,
    fromPrice: 35,
    defaultVariantId: DEFAULT_VARIANT_ID,
    variants: VARIANTS.map((variant) => ({ ...variant })),
  }));
  catalog.productCount = catalog.products.length;
  await write(path, `${JSON.stringify(catalog, null, 2)}\n`);
}

